{
  "name": "my-jarvis",
  "version": "0.1.0",
  "private": true,
  "description": "Jarvis Pet의 macOS 임시 알과 로컬 저장·복원 검증",
  "main": "dist/src/main/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "npm run build && electron .",
    "test": "npm run build && node scripts/test.mjs",
    "package:mac": "npm run build && node scripts/package-mac.mjs",
    "test:mac-package": "npm run build && node scripts/test-mac-package.mjs",
    "test:notifications": "npm run build && electron dist/tests/notifications-checks.js",
    "test:ci": "npm run build && node scripts/test-ci.mjs"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "44.4.5",
    "typescript": "7.0.2"
  }
}
